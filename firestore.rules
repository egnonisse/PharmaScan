rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Administrateurs : identifiés par leur email Firebase Auth.
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email in ['egnonisse@gmail.com', 'tobossinonleonard@gmail.com'];
    }

    // Archives des reçus : écrites par la Cloud Function (admin SDK).
    // Lecture, correction (update) et suppression réservées à l'admin.
    match /receipts/{receiptId} {
      allow read: if isAdmin();
      allow create: if false;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Table de recherche des prix : lue par les utilisateurs authentifiés
    // (recherche médicament), écrite par la Cloud Function,
    // recréée par l'admin lors d'une correction de reçu, supprimée en cascade.
    match /priceEntries/{entryId} {
      allow read: if request.auth != null;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Pharmacies : lues par les utilisateurs connectés (app),
    // gérées par l'admin (CRUD + dates de garde).
    match /pharmacies/{pharmacyId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // Questions secrètes (connexion par numéro) : lues par les connectés,
    // gérées par l'admin (CRUD + activer/désactiver).
    match /securityQuestions/{questionId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // Configuration de contenu (visibilité des médicaments, catégories
    // désactivées) : lue par les connectés, écrite par l'admin.
    match /contentConfig/{docId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // Catalogue parapharmacie : lecture par les utilisateurs connectés,
    // écriture par l'admin (imports).
    match /catalogProducts/{productId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // Candidats de fusion de pharmacies (détection automatique).
    // lus et gérés par l'admin uniquement (validation dans le dashboard).
    match /mergeCandidates/{candidateId} {
      allow read, write: if isAdmin();
    }

    // Profil utilisateur : le client ne peut créer que son propre profil
    // avec points == 0, et ne peut modifier QUE currencyCode.
    // Configuration des points (montant par scan) : lue par tous (l'app
    // peut l'afficher), écrite par l'admin. La Cloud Function la lit via
    // l'Admin SDK.
    match /pointsConfig/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // État de lecture des notifications (par utilisateur) : l'utilisateur
    // marque ses propres notifications comme lues.
    match /users/{userId}/readAnnouncements/{announcementId} {
      allow read, write: if request.auth != null
          && request.auth.uid == userId;
    }

    // points / createdAt / pointsEvents sont gérés par la Cloud Function.
    // L'admin peut lire et corriger les profils (support utilisateurs).
    match /users/{userId} {
      allow read: if request.auth != null
          && (request.auth.uid == userId || isAdmin());

      allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['points', 'currencyCode', 'createdAt', 'referralCode', 'referredByName', 'phone', 'firstName', 'lastName', 'birthDate', 'gender', 'profileCompleted'])
          && request.resource.data.points == 0
          && request.resource.data.currencyCode is string;

      allow update: if request.auth != null
          && (request.auth.uid == userId
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currencyCode', 'fcmToken', 'referralCode', 'firstName', 'lastName', 'birthDate', 'gender', 'profileCompleted'])
              || isAdmin());

      allow delete: if false;
    }

    // Campagnes (bannières home) : lues par les utilisateurs connectés,
    // gérées par l'admin (CRUD). Champs : title, subtitle, active,
    // startDate/endDate, backgroundColor, textColor, pharmacyId/url, sortOrder.
    match /campaigns/{campaignId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // Annonces (popups in-app) : lues par les utilisateurs connectés,
    // gérées par l'admin. Champs : title, message, type (promo/rappel/info),
    // active, startDate/endDate, ctaLabel/ctaUrl, oncePerUser.
    match /announcements/{announcementId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // Réglages IA (structuration des reçus) : accessibles uniquement aux
    // admins (contient la clé API). Champs : enabled, provider, baseUrl,
    // model, apiKey. La Cloud Function lit ce doc via l'Admin SDK.
    match /aiSettings/{docId} {
      allow read, write: if isAdmin();
    }

    // Demandes d'envoi push : écrites par l'admin depuis le dashboard,
    // traitées par la Cloud Function (onDocumentCreated) qui écrit le
    // résultat (sent/failed/status) dans le même doc.
    match /pushRequests/{requestId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // Pages légales (politique de confidentialité, CGU, mentions légales,
    // avertissement médical, consentement) : lues par les utilisateurs
    // connectés, éditées par l'admin. Champs : key, title, content.
    match /legalPages/{pageId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // Référentiel médicaments (ANSM) : lu par les utilisateurs connectés
    // (autocomplétion de la recherche), importé par le scraper admin.
    match /medications/{medicationId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // Historique des points : lecture par le propriétaire (app) et par
    // l'admin (dashboard), écriture par la Cloud Function et l'admin
    // (ajustements manuels avec motif).
    match /users/{userId}/pointsEvents/{eventId} {
      allow read: if request.auth != null
          && (request.auth.uid == userId || isAdmin());
      allow create, update, delete: if isAdmin();
    }
  }
}
